# Supabase (Auth + Postgres + Storage + Edge Functions)
# Project Settings → API Keys. Sirve la "publishable" (sb_publishable_...) o la anon legacy.
VITE_SUPABASE_URL=https://mcunzjvyducymqfxcgfi.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Contraseña del gate del dashboard público en "/". Si se omite, usa el default del componente.
VITE_DASHBOARD_PASSWORD=

# Branding overrides (optional). Leave empty to use the defaults from src/config/branding.ts.
VITE_BRAND_NAME=Group I.A
VITE_BRAND_LOGO=/logos/group-ia.svg
VITE_BRAND_TAGLINE=Evolucionamos con la IA
VITE_BRAND_MONOGRAM=IA

